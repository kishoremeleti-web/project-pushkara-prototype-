# Pushkaralu Digi-Token Firebase Configuration
# Copy this file to .env and fill in your values from Firebase Console
# (Project Settings > General > Your apps > Web app)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pushkaras-prototype.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pushkaras-prototype
VITE_FIREBASE_STORAGE_BUCKET=pushkaras-prototype.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
